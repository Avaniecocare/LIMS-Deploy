# Copy to .env and fill in. Nothing else needs editing. Passwords are made on first start and are not kept here.

# The release, as exact versions.
LIMS_VERSION=
LIMS_UI_VERSION=

# The licence or trial you were sent (one line). It can also be added later in Admin, Licence.
LICENCE=

# The one address people open, as they type it. Emails, QR codes and file links use it, and any other address is refused.
# On this machine only: http://localhost:8080. For other computers and phones, see README.md first.
LIMS_URL=http://localhost:8080
LIMS_PORT=8080
# 127.0.0.1 is this machine only; 0.0.0.0 is the whole network.
LIMS_BIND=127.0.0.1
# true when LIMS_URL is https://
COOKIE_SECURE=false

BRAND_NAME=LIMS

# Mail. Until SMTP_TRANSPORT is smtp, mail is recorded in the app and not sent.
SMTP_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lims@localhost.example
