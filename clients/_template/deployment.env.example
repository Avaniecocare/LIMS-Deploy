# Where and how this company runs. Secrets are generated by scripts/provision.sh into
# secrets.env beside this file. Don't put passwords here, except the SMTP one.

# The product name shown until the lab's administrator sets the lab's own name and app name in the setup
# wizard. The only branding value outside the app; logo, colours and all lab details are set in the app.
BRAND_NAME="LIMS"

CLIENT_SLUG="example"                 # lowercase letters, digits, hyphens. Names containers and volumes
APP_DOMAIN="app.example.example"      # frontend
API_DOMAIN="api.example.example"      # backend; same parent domain as APP_DOMAIN
FILES_DOMAIN="files.example.example"  # object storage, used for short-lived signed links

# S3-compatible storage image, pinned to an exact version. It must store its data under /data
# and listen on port 9000. See DECISIONS.md: official MinIO images are no longer published.
S3_IMAGE=""

# Mail provider
SMTP_HOST="smtp.example.example"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="lab@example.example"

# Optional
# SMTP_TRANSPORT="json"               # trials only: writes mail to the log instead of sending it
# DATABASE_READ_URL=""                # read replica for reports and dashboards
# ERROR_TRACKING_DSN=""
# WhatsApp Business Cloud API, from WhatsApp Manager > API setup (a permanent system-user token).
# Like the SMTP password, the token is the one secret allowed here. Leave both empty for no WhatsApp.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# For delivered/read ticks: the Meta app secret and a verify token of your choice (see Admin > WhatsApp).
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""
# Help assistant ("Ask AI" on /help). Off by default. Use a separate Anthropic key with a spending limit.
# ENABLE_AI_ASSISTANT="true"
# AI_API_KEY=""
# AI_MODEL="claude-haiku-5-5"
# DAILY_BUDGET_LIMIT="1"
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Memory caps per container. These are the defaults (about 2.8 GB per company in total); uncomment
# to change. A container over its cap is restarted, rather than the kernel killing something
# else on the server. Raise WORKER_MEM_LIMIT first if large PDFs fail; see DEPLOYMENT.md.
# POSTGRES_MEM_LIMIT="512m"
# REDIS_MEM_LIMIT="128m"
# S3_MEM_LIMIT="256m"
# API_MEM_LIMIT="768m"
# WORKER_MEM_LIMIT="1g"               # runs Chromium for PDFs
# UI_MEM_LIMIT="64m"

# Storage healthcheck. The default probes port 9000 with whatever the image has (curl, wget,
# node or nc) and needs /bin/sh. Override only if S3_IMAGE has none of those.
# S3_HEALTHCHECK_CMD="..."

# --- Backups (scripts/backup.sh, nightly at 02:00 via install-backup-cron.sh) --------------------
BACKUP_RETENTION_DAYS="30"            # local backups older than this are deleted
# Encrypt backups: set ONE of these. Keep the private key / passphrase OFF this server.
# BACKUP_AGE_RECIPIENT="age1..."      # age public key(s), space-separated (recommended)
# BACKUP_GPG_RECIPIENT="ops@example.example"   # public key already in this user's gpg keyring
# BACKUP_GPG_PASSPHRASE_FILE="/root/.lims-backup-pass"   # symmetric gpg; file mode 600
# Decrypting for restore.sh (only on the machine that restores):
# BACKUP_AGE_IDENTITY_FILE="/path/to/age-key.txt"
# Off-site copy, run after each nightly backup. Use SINGLE quotes so $BACKUP_FILE (the encrypted
# archive) and $CLIENT_SLUG are filled in when it runs. Refused for unencrypted backups unless
# BACKUP_OFFSITE_ALLOW_PLAINTEXT="true".
# BACKUP_OFFSITE_CMD='rclone copy "$BACKUP_FILE" offsite:lims-backups/$CLIENT_SLUG/'
# BACKUP_OFFSITE_CMD='aws s3 cp "$BACKUP_FILE" "s3://example-lims-backups/$CLIENT_SLUG/"'
# Dead-man's switch: fetched after each fully successful backup (e.g. a healthchecks.io URL),
# so a missing ping alerts you.
# BACKUP_PING_URL=""

# Sessions end this many hours after sign-in (default 12).
# SESSION_MAX_HOURS="12"
# PIN code auto-fill through the server; set to "" to turn it off (for example on a server without internet access).
# PINCODE_LOOKUP_URL="https://api.postalpincode.in/pincode/"
