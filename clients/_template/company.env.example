# Company details for one deployment. Copy this folder OUTSIDE this repository, fill it in,
# and pass that location to the scripts (see ONBOARDING.md). Never commit a real company's file.
#
# Rules for values:
#  - Double-quote every value. Unquoted, "#" starts a comment and spaces break tools.
#  - The app validates these at startup and refuses to start on a missing or invalid value,
#    naming the variable.
#  - Changing a value needs a restart (scripts/deploy.sh). Issued documents keep the details
#    they were issued with.

# --- Identity ---------------------------------------------------------------
COMPANY_PRODUCT_NAME="Example LIMS"            # shown in the browser title and navigation
COMPANY_NAME="Example Testing Labs"            # short trading name
COMPANY_LEGAL_NAME="Example Testing Labs Private Limited"   # printed on documents

# --- Tax and registration ---------------------------------------------------
COMPANY_GSTIN="27AAAAA0000A1Z2"                # format and check digit are validated
COMPANY_PAN="AAAAA0000A"                       # must match characters 3-12 of the GSTIN
COMPANY_CIN=""                                 # optional
COMPANY_STATE="Maharashtra"
COMPANY_GST_STATE_CODE="27"                    # must match the first two digits of the GSTIN
COMPANY_SAC_CODE="998346"                      # printed on tax invoices
COMPANY_SAC_DESCRIPTION="Technical testing and analysis services"

# --- Contact ----------------------------------------------------------------
COMPANY_REGISTERED_ADDRESS="Unit 1, Example Industrial Estate, Pune 411001"
COMPANY_LAB_ADDRESS="Unit 1, Example Industrial Estate, Pune 411001"
COMPANY_PHONE="+91 20 0000 0000"
COMPANY_EMAIL="lab@example.example"
COMPANY_WEBSITE=""                             # optional
COMPANY_REPORT_VERIFICATION_EMAIL="verify@example.example"   # printed on every report footer

# --- Bank (never shown without a login) ---------------------------------------
COMPANY_BANK_ACCOUNT_NAME="Example Testing Labs Private Limited"
COMPANY_BANK_ACCOUNT_NUMBER="000000000000"
COMPANY_BANK_NAME="Example Bank"
COMPANY_BANK_BRANCH="Main Branch"
COMPANY_BANK_IFSC="EXMP0000001"
COMPANY_BANK_SWIFT=""                          # optional

# --- Branding ---------------------------------------------------------------
# Files live in this folder's branding/ directory, which is mounted read-only at /branding.
COMPANY_BRANDING_DIR="/branding"
COMPANY_LOGO_PATH="logo.png"                   # PNG, JPEG, SVG or WebP
COMPANY_FAVICON_PATH="favicon.png"
COMPANY_PRIMARY_COLOR="#0f4c81"                # #rrggbb. Navigation and headings
COMPANY_ACCENT_COLOR="#0e9f6e"

# --- Accreditation ----------------------------------------------------------
# Nothing about accreditation prints unless it is enabled here.
COMPANY_CERTIFICATION_TEXT=""                  # certification line for document footers
COMPANY_NABL_MODE="off"                        # "on" or "off"
COMPANY_NABL_CERTIFICATE_NO=""                 # required when NABL mode is on
COMPANY_ULR_FORMAT=""                          # required when on. Tokens: {FY} {SEQ:8}

# --- Documents --------------------------------------------------------------
COMPANY_DOCUMENT_PREFIX="EX"                   # 1-10 letters, digits or hyphens; starts document numbers
